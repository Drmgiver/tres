#!/bin/sh
# User-specific Labwc autostart for the package-managed Tres session.
mkdir -p "$HOME/.cache/tres"
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP >/dev/null 2>&1 || true
fi
/usr/bin/tres-wallpaper >/dev/null 2>&1 &
/usr/bin/tres-panel-supervisor >/dev/null 2>&1 &
